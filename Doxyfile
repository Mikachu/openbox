# Doxygen configuration for Openbox API documentation

# Project information
PROJECT_NAME           = \"Openbox 4\"
PROJECT_NUMBER         = \"4.0.0\"
PROJECT_BRIEF          = \"Modern Stacking Window Manager\"
PROJECT_LOGO           = docs/assets/logo.png

# Input files
INPUT                  = openbox obt obrender rust/src
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.c *.h *.rs *.md
RECURSIVE              = YES
EXCLUDE                = tests build target .git
EXCLUDE_PATTERNS       = */tests/* */build/* */target/*

# Output
OUTPUT_DIRECTORY       = docs/api/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Build options
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

# C/C++ specific
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTENSION_MAPPING      = rs=C++

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = .

# Warnings
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES

# Index
ALPHABETICAL_INDEX     = YES
COLS_IN_ALPHA_INDEX    = 5

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100

# XML output for Sphinx/Breathe
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

# LaTeX output
GENERATE_LATEX         = NO

# Man pages
GENERATE_MAN           = NO

# Dot/graphviz
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
DOT_FONTNAME           = Helvetica
DOT_FONTSIZE           = 10
DOT_FONTPATH           =
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = NO
TEMPLATE_RELATIONS     = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_PATH               =
DOTFILE_DIRS           =
MSCFILE_DIRS           =
DIAFILE_DIRS           =
PLANTUML_JAR_PATH      =
PLANTUML_INCLUDE_PATH  =
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 0
DOT_TRANSPARENT        = YES
DOT_MULTI_TARGETS      = NO
GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES

# Search
SEARCHENGINE           = YES

# External links
EXTERNAL_GROUPS        = YES
EXTERNAL_PAGES         = YES

# Perl path
PERL_PATH              = /usr/bin/perl

# Configuration for Rust (via rustdoc)
USE_MDFILE_AS_MAINPAGE = README.md
