<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<component type=\"desktop-application\">
  <id>org.openbox.Openbox</id>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <name>Openbox</name>
  <summary>Highly configurable, next-generation stacking window manager</summary>
  <description>
    <p>Openbox is a lightweight window manager for X11 and Wayland. It provides a fast, modern, and highly configurable environment for managing application windows.</p>
    <p>Features:</p>
    <ul>
      <li>Written in Rust for memory safety and performance</li>
      <li>CSS-based theming with dark mode support</li>
      <li>D-Bus IPC for modern desktop integration</li>
      <li>Extension API for plugins</li>
      <li>Python bindings for automation</li>
      <li>xdg-desktop-portal support for sandboxed apps</li>
    </ul>
  </description>
  <launchable type=\"desktop-id\">org.openbox.Openbox.desktop</launchable>
  <screenshots>
    <screenshot type=\"default\">
      <image>https://openbox.org/screenshots/openbox-4-default.png</image>
      <caption>Default Openbox 4 desktop</caption>
    </screenshot>
  </screenshots>
