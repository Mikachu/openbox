from typing import List, Optional, Dict, Any, Tuple, Callable, Union, AsyncIterator
from dataclasses import dataclass
from enum import IntFlag
import asyncio

class WindowState(IntFlag):
    MODAL: int
    STICKY: int
    MAXIMIZED_VERT: int
    MAXIMIZED_HORZ: int
    SHADED: int
    SKIP_TASKBAR: int
    SKIP_PAGER: int
    HIDDEN: int
    FULLSCREEN: int
    ABOVE: int
    BELOW: int
    DEMANDS_ATTENTION: int

class WindowType(IntFlag):
    NORMAL: int
    DIALOG: int
    UTILITY: int
    MENU: int
    TOOLBAR: int
    SPLASH: int
    DOCK: int
    DESKTOP: int
    NOTIFICATION: int

@dataclass(frozen=True)
class Geometry:
    x: int
    y: int
    width: int
    height: int
    
    @property
    def area(self) -> int: ...
    def contains(self, px: int, py: int) -> bool: ...
    def intersects(self, other: 'Geometry') -> bool: ...
    def __iter__(self): ...

@dataclass(frozen=True)
class Window:
    id: int
    title: str
    wm_class: str
    wm_instance: str
    window_type: WindowType
    desktop: int
    states: WindowState
    geometry: Geometry
    is_focused: bool
    is_visible: bool
    
    @property
    def is_maximized(self) -> bool: ...
    @property
    def is_fullscreen(self) -> bool: ...
    @property
    def is_sticky(self) -> bool: ...
    @property
    def is_shaded(self) -> bool: ...

@dataclass(frozen=True)
class Desktop:
    number: int
    name: str
    is_current: bool
    window_count: int

@dataclass
class Monitor:
    number: int
    name: str
    geometry: Geometry
    is_primary: bool
    
    @property
    def is_active(self) -> bool: ...

class SignalEmitter:
    def connect(self, signal: str, callback: Callable) -> None: ...
    def disconnect(self, signal: str, callback: Callable) -> None: ...
    def emit(self, signal: str, *args, **kwargs) -> None: ...

class AsyncWindowManager:
    def __init__(self, bus_address: Optional[str] = None) -> None: ...
    async def __aenter__(self) -> 'AsyncWindowManager': ...
    async def __aexit__(self, exc_type, exc_val, exc_tb) -> None: ...
    async def connect(self, max_retries: int = 3) -> None: ...
    async def disconnect(self) -> None: ...
    @property
    def is_connected(self) -> bool: ...
    @property
    def version(self) -> Optional[str]: ...
    async def get_windows(self) -> List[Window]: ...
    async def get_window(self, window_id: int) -> Optional[Window]: ...
    async def get_window_by_title(self, title: str, case_sensitive: bool = False) -> Optional[Window]: ...
    async def get_active_window(self) -> Optional[Window]: ...
    async def focus_window(self, window: Union[Window, int]) -> None: ...
    async def close_window(self, window: Union[Window, int]) -> None: ...
    async def move_window(self, window: Union[Window, int], x: int, y: int) -> None: ...
    async def resize_window(self, window: Union[Window, int], width: int, height: int) -> None: ...
    async def maximize_window(self, window: Union[Window, int], horizontal: bool = True, vertical: bool = True) -> None: ...
    async def minimize_window(self, window: Union[Window, int]) -> None: ...
    async def get_desktops(self) -> List[Desktop]: ...
    async def switch_desktop(self, desktop_number: int) -> None: ...
    async def send_window_to_desktop(self, window: Union[Window, int], desktop: int) -> None: ...
    async def execute(self, command: str) -> None: ...
    async def reconfigure(self) -> None: ...
    async def restart(self) -> None: ...
    async def exit(self) -> None: ...
    async def get_config(self, key: str) -> Any: ...
    async def set_config(self, key: str, value: Any) -> None: ...

class WindowManager(AsyncWindowManager):
    def __init__(self, *args, **kwargs) -> None: ...
    def get_windows(self) -> List[Window]: ...
    def get_active_window(self) -> Optional[Window]: ...
    def focus_window(self, window: Union[Window, int]) -> None: ...
    def close_window(self, window: Union[Window, int]) -> None: ...
    def move_window(self, window: Union[Window, int], x: int, y: int) -> None: ...
    def resize_window(self, window: Union[Window, int], width: int, height: int) -> None: ...
    def get_desktops(self) -> List[Desktop]: ...
    def switch_desktop(self, desktop_number: int) -> None: ...

async def get_wm() -> AsyncWindowManager: ...
