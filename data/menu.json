{
  "$schema": "https://openbox.org/schemas/menu-4.0.json",
  "version": "4.0.0",
  
  "menus": [
    {
      "id": "apps-accessories-menu",
      "label": "Accessories",
      "items": [
        {
          "type": "item",
          "label": "Calculator",
          "action": {
            "name": "Execute",
            "command": "gnome-calculator",
            "startup_notify": {
              "enabled": true
            }
          }
        },
        {
          "type": "item",
          "label": "Character Map",
          "action": {
            "name": "Execute",
            "command": "gnome-character-map",
            "startup_notify": {
              "enabled": true
            }
          }
        },
        {
          "type": "item",
          "label": "Ark File Archiver",
          "action": {
            "name": "Execute",
            "command": "ark",
            "startup_notify": {
              "enabled": true
            }
          }
        }
      ]
    },
    {
      "id": "apps-term-menu",
      "label": "Terminals",
      "items": [
        {
          "type": "item",
          "label": "Rxvt Unicode",
          "action": {
            "name": "Execute",
            "command": "urxvt"
          }
        },
        {
          "type": "item",
          "label": "Gnome Terminal",
          "action": {
            "name": "Execute",
            "command": "gnome-terminal",
            "startup_notify": {
              "enabled": true
            }
          }
        },
        {
          "type": "item",
          "label": "Xterm",
          "action": {
            "name": "Execute",
            "command": "xterm"
          }
        }
      ]
    },
    {
      "id": "system-menu",
      "label": "System",
      "items": [
        {
          "type": "item",
          "label": "Openbox Configuration Manager",
          "action": {
            "name": "Execute",
            "command": "obconf",
            "startup_notify": {
              "enabled": true
            }
          }
        },
        {
          "type": "separator"
        },
        {
          "type": "item",
          "label": "Reconfigure Openbox",
          "action": {
            "name": "Reconfigure"
          }
        }
      ]
    },
    {
      "id": "root-menu",
      "label": "Openbox 4",
      "items": [
        {
          "type": "separator",
          "label": "Applications"
        },
        {
          "type": "menu",
          "id": "apps-accessories-menu"
        },
        {
          "type": "menu",
          "id": "apps-term-menu"
        },
        {
          "type": "separator",
          "label": "System"
        },
        {
          "type": "menu",
          "id": "system-menu"
        },
        {
          "type": "separator"
        },
        {
          "type": "item",
          "label": "Log Out",
          "action": {
            "name": "Exit",
            "prompt": true
          }
        }
      ]
    }
  ]
}
