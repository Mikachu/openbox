#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

%:
n\tdh $@ --with python3

override_dh_auto_configure:
n\tmeson setup debian/build \
n\t\t--prefix=/usr \
n\t\t--buildtype=release \
n\t\t-Dportal=true \
n\t\t-Dextensions=true \
n\t\t-Dpython-bindings=true

override_dh_auto_build:
n\tninja -C debian/build

override_dh_auto_test:
n\tmeson test -C debian/build --print-errorlogs || true

override_dh_auto_install:
n\tDESTDIR=$(CURDIR)/debian/tmp ninja -C debian/build install

override_dh_install:
n\tdh_install
n\t# Install Python bindings
n\tcd python && python3 setup.py install --root=$(CURDIR)/debian/python3-openbox --install-layout=deb

override_dh_missing:
n\tdh_missing --fail-missing

override_dh_shlibdeps:
n\tdh_shlibdeps -Lopenbox

override_dh_makeshlibs:
n\tdh_makeshlibs -V

override_dh_gencontrol:
n\tdh_gencontrol

override_dh_clean:
n\tdh_clean
n\trm -rf debian/build
